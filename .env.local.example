# Public Supabase values used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Never expose these in client code or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Required to authorize scheduled ingestion routes in production.
CRON_SECRET=
